{
  "name": "pirate-crew-web",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "test:hosting": "node scripts/hosting-check.mjs",
    "format": "prettier --write src tests scripts vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src tests scripts vite.config.ts tsconfig.json package.json index.html",
    "test:sea:browser": "node scripts/sea-browser-check.mjs",
    "test:ships:browser": "node scripts/ship-browser-check.mjs",
    "test:furniture:browser": "node scripts/furniture-browser-check.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
